# Servidor opcional (server/README.md). Copie para .env e ajuste; nunca versione o .env.
PORT=3600
HOST=127.0.0.1
# Conexão com um banco PostgreSQL dedicado (as tabelas são criadas na inicialização).
DATABASE_URL=postgres://campo_user:TROQUE-ESTA-SENHA@127.0.0.1:5432/campo_db
# Opcional: origens extras aceitas em formulários/API, separadas por vírgula (o próprio host já é aceito).
# PUBLIC_ORIGIN=https://levantamento.exemplo.com.br
# Opcional, só para o seed do primeiro administrador (senão: usuário "admin" e senha gerada).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# Opcional: onde guardar os arquivos das fotos sincronizadas (padrão: ./data/photos). Faça backup desta pasta.
# PHOTO_STORAGE_DIR=/srv/campo-fotos
